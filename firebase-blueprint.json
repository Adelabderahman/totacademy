{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Information and profile details for registered TOT Academy users",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user identifier"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "phone": {
          "type": "string",
          "description": "Phone number with country code"
        },
        "country": {
          "type": "string",
          "description": "User country or wilaya"
        },
        "role": {
          "type": "string",
          "enum": ["trainer", "trainee"],
          "description": "Role in the academy"
        },
        "avatar": {
          "type": "string",
          "description": "URL to the user avatar"
        },
        "bio": {
          "type": "string",
          "description": "Brief biography or credentials"
        },
        "badgeNumber": {
          "type": "string",
          "description": "Official academy membership or registration code"
        },
        "isVerified": {
          "type": "boolean",
          "description": "Verification status"
        },
        "joinedDate": {
          "type": "string",
          "description": "Join date string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "EnrolledTrack": {
      "title": "EnrolledTrack",
      "description": "Training track or course enrollment for a user",
      "type": "object",
      "properties": {
        "trackId": {
          "type": "string",
          "description": "Identifier of the educational track"
        },
        "userId": {
          "type": "string",
          "description": "ID of the enrolled user"
        },
        "title": {
          "type": "string",
          "description": "Track title"
        },
        "titleAr": {
          "type": "string",
          "description": "Track title in Arabic"
        },
        "progress": {
          "type": "number",
          "description": "Completion percentage (0 to 100)"
        },
        "completedLessons": {
          "type": "number",
          "description": "Count of finished lessons"
        },
        "totalLessons": {
          "type": "number",
          "description": "Total lessons in the track"
        },
        "status": {
          "type": "string",
          "enum": ["registered", "in_progress", "completed"],
          "description": "Enrollment status"
        },
        "nextSessionDate": {
          "type": "string",
          "description": "Next scheduled workshop or lecture"
        },
        "enrolledAt": {
          "type": "string",
          "description": "Enrollment timestamp"
        }
      },
      "required": ["trackId", "userId", "title", "status"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Accredited certification issued to the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Certificate document ID"
        },
        "userId": {
          "type": "string",
          "description": "Recipient user ID"
        },
        "code": {
          "type": "string",
          "description": "Unique verification code"
        },
        "title": {
          "type": "string",
          "description": "Certificate title"
        },
        "issueDate": {
          "type": "string",
          "description": "Issue date"
        },
        "grade": {
          "type": "string",
          "description": "Honors or grade"
        },
        "hours": {
          "type": "number",
          "description": "Accredited training hours"
        }
      },
      "required": ["id", "userId", "code", "title"]
    },
    "TrackProgress": {
      "title": "TrackProgress",
      "description": "Detailed lesson and quiz progress tracking for an enrolled user",
      "type": "object",
      "properties": {
        "trackKey": {
          "type": "string",
          "description": "Key of the educational track"
        },
        "userId": {
          "type": "string",
          "description": "ID of the enrolled user"
        },
        "activeLevel": {
          "type": "string",
          "description": "Currently active level"
        },
        "activeModuleId": {
          "type": "string",
          "description": "Currently active module ID"
        },
        "completedLessons": {
          "type": "object",
          "description": "Completed lesson IDs by module"
        },
        "completedQuizzes": {
          "type": "object",
          "description": "Completed quiz IDs by module"
        },
        "overallProgress": {
          "type": "number",
          "description": "Calculated progress percentage"
        },
        "reportCode": {
          "type": "string",
          "description": "Latest assessment report reference code"
        },
        "lastUpdated": {
          "type": "string",
          "description": "ISO timestamp of last progress update"
        }
      },
      "required": ["trackKey", "userId"]
    },
    "ConfirmedEnrollment": {
      "title": "ConfirmedEnrollment",
      "description": "Irreversible official registration confirmation record with snapshot of user progress",
      "type": "object",
      "properties": {
        "trackKey": {
          "type": "string",
          "description": "Key of the educational track"
        },
        "userId": {
          "type": "string",
          "description": "ID of the confirmed user"
        },
        "userName": {
          "type": "string",
          "description": "Name of the user"
        },
        "userEmail": {
          "type": "string",
          "description": "Email address"
        },
        "confirmedAt": {
          "type": "string",
          "description": "ISO timestamp of official enrollment confirmation"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed"],
          "description": "Confirmation status"
        },
        "isConfirmed": {
          "type": "boolean",
          "description": "Confirmation boolean flag"
        },
        "overallProgressSnapshot": {
          "type": "number",
          "description": "Progress percentage at time of confirmation"
        },
        "completedLessonsSnapshot": {
          "type": "object",
          "description": "Snapshot of completed lessons"
        },
        "completedQuizzesSnapshot": {
          "type": "object",
          "description": "Snapshot of completed quizzes"
        },
        "trackTitleAr": {
          "type": "string",
          "description": "Arabic track title"
        }
      },
      "required": ["trackKey", "userId", "confirmedAt", "status", "isConfirmed"]
    },
    "CMSConfig": {
      "title": "CMSConfig",
      "description": "Live CMS studio content configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "hero": {
          "type": "object",
          "description": "Hero section content"
        },
        "modules": {
          "type": "array",
          "description": "List of dynamic modules"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of update"
        }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records stored by auth UID"
    },
    "/users/{userId}/enrolledTracks/{trackId}": {
      "schema": "EnrolledTrack",
      "description": "User track enrollments and course progress"
    },
    "/users/{userId}/trackProgress/{trackId}": {
      "schema": "TrackProgress",
      "description": "Detailed lesson progress and active module resume state"
    },
    "/users/{userId}/confirmedEnrollments/{trackId}": {
      "schema": "ConfirmedEnrollment",
      "description": "Official confirmation record of user track enrollment with progress snapshots"
    },
    "/users/{userId}/certificates/{certId}": {
      "schema": "Certificate",
      "description": "Official academy certificates issued to the user"
    },
    "/users/{userId}/appointments/{apptId}": {
      "schema": "object",
      "description": "Scheduled appointments and interactive workshops"
    },
    "/cms/{documentId}": {
      "schema": "CMSConfig",
      "description": "Dynamic CMS settings and modules"
    }
  }
}
