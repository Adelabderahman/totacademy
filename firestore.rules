rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection check for boot verification
    match /test/connection {
      allow read: if true;
    }

    // User Profile Rules (Protected with ownership checks & PII isolation)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User's Enrolled Tracks Subcollection
      match /enrolledTracks/{trackId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(trackId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User's Track Progress Subcollection
      match /trackProgress/{trackId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(trackId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User's Certificates Subcollection
      match /certificates/{certId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(certId);
        allow delete: if false;
      }

      // User's Appointments Subcollection
      match /appointments/{apptId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(apptId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }
    }

    // CMS Studio settings
    match /cms/{documentId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(documentId);
      allow delete: if false;
    }
  }
}
