rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection check for boot verification
    match /test/connection {
      allow read: if true;
    }

    // User Profile Rules (Protected with ownership checks & PII isolation)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // User's Enrolled Tracks Subcollection
      match /enrolledTracks/{trackId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(trackId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User's Track Progress Subcollection
      match /trackProgress/{trackId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(trackId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User's Confirmed Enrollments (تأكيد التسجيل في المسار - غير قابل للإلغاء أو الحذف)
      match /confirmedEnrollments/{trackId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(trackId);
        allow delete: if false; // لا يمكن إلغاء التأكيد أو حذف المسار المؤكد أبداً
      }

      // User's Certificates Subcollection
      match /certificates/{certId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(certId);
        allow delete: if false;
      }

      // User's Appointments Subcollection
      match /appointments/{apptId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(apptId);
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User's Notifications Subcollection
      match /notifications/{notifId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(userId) && isValidId(notifId);
      }
    }

    // Global Appointments (for admin dashboard oversight and real-time operations)
    match /appointments/{apptId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(apptId);
    }

    // Global Certificate Requests (for admin dashboard review and issuance)
    match /certificate_requests/{reqId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(reqId);
    }

    // Global Broadcast Notifications
    match /notifications/{notifId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(notifId);
    }

    // CMS Studio settings
    match /cms/{documentId} {
      allow get, list: if true;
      allow create, update: if isValidId(documentId);
      allow delete: if false;
    }

    // Dynamic Curriculum Tracks (Public read, valid ID write)
    match /tracks/{trackId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(trackId);
    }

    // Dynamic Magazine Articles (Public read, valid ID write)
    match /magazine_articles/{articleId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(articleId);
    }

    // Events Collection
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(eventId);
    }

    // Trainers Collection
    match /trainers/{trainerId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(trainerId);
    }
  }
}
