rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // User's Enrolled Tracks Subcollection
      match /enrolledTracks/{trackId} {
        allow read, write: if isOwner(userId);
      }

      // User's Certificates Subcollection
      match /certificates/{certId} {
        allow read, write: if isOwner(userId);
      }

      // User's Appointments Subcollection
      match /appointments/{apptId} {
        allow read, write: if isOwner(userId);
      }
    }

    // CMS Studio settings
    match /cms/{documentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
